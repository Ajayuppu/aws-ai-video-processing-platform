{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowEventBridgeRule",
      "Effect": "Allow",
      "Principal": {
        "Service": "events.amazonaws.com"
      },
      "Action": "sqs:SendMessage",
      "Resource": "arn:aws:sqs:__REGION__:__ACCOUNT_ID__:video-jobs-queue",
      "Condition": {
        "ArnEquals": {
          "aws:SourceArn": "arn:aws:events:__REGION__:__ACCOUNT_ID__:rule/video-uploaded-rule"
        }
      }
    }
  ]
}
